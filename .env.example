# QuantLab unified configuration
# Copy this file to .env at the repository root. Both local processes and
# Docker Compose read it. Do not commit the resulting .env file.

# Local development infrastructure. Docker Compose substitutes its internal
# postgres / redis hostnames automatically while retaining these credentials.
POSTGRES_DB=quantlab
POSTGRES_USER=quantlab
POSTGRES_PASSWORD=change-this-postgres-password
DATABASE_URL=postgresql+asyncpg://quantlab:change-this-postgres-password@127.0.0.1:5432/quantlab
REDIS_DB=0
REDIS_URL=redis://127.0.0.1:6380/0

# Service ports and browser-facing API routing.
QUANTLAB_FRONTEND_PORT=5173
QUANTLAB_BACKEND_PORT=8000
QUANTLAB_REDIS_PORT=6380
QUANTLAB_POSTGRES_PORT=5432
BACKEND_HOST=backend
BACKEND_PORT=8000
VITE_DEV_PORT=5173
VITE_BACKEND_URL=http://127.0.0.1:8000
VITE_API_URL=/api
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Data, backtests, and strategy workspaces. Relative paths are resolved from backend/.
DATA_ROOT=data
ARTIFACT_ROOT=data/backtests
CATALOG_PATH=catalog
STRATEGY_REPO_PATH=..
STRATEGY_GIT_REPO_PATH=data/strategy-repository
BACKTEST_TIMEOUT_SECONDS=3600
BACKTEST_SANDBOX=true
INSTRUMENT_ID_TEMPLATE={symbol}-PERP.{venue}
AGENT_MAX_CONCURRENCY=5
AGENT_WORKSPACE_RETENTION_DAYS=7
DATA_DOWNLOAD_CONCURRENCY=8

# Authentication and encrypted-at-rest configuration. Generate distinct
# production secrets before deployment.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-this-admin-password
AUTH_JWT_SECRET=change-this-to-a-long-random-jwt-secret
AUTH_TOKEN_EXPIRE_HOURS=168
LLM_SECRET_ENCRYPTION_KEY=change-this-to-a-stable-long-random-encryption-secret

# DeepSeek Harness runtime. DSH_API_KEY / BASE_URL / MODEL are optional when
# configured from the Settings page; set them here to provide deployment-wide
# overrides before the first UI configuration.
DSH_BASE_URL=https://api.deepseek.com/v1
DSH_API_KEY=
DSH_MODEL=deepseek-chat
DSH_MAX_TOKENS=32768
DSH_INTENT_TIMEOUT_SECONDS=45
DSH_BRIDGE_URL=http://127.0.0.1:8000/api
DSH_BRIDGE_TOKEN=
DSH_RESEARCH_TIMEOUT_SECONDS=180
DSH_RESEARCH_MAX_TOOL_CALLS=5
DSH_TOOL_RESULT_MAX_CHARS=8000
DSH_WEB_SEARCH_TIMEOUT_SECONDS=12

# Optional developer-only DSH SDK probe (backend/scripts/dsh_sdk_probe.py).
DSH_PROBE_BASE_URL=https://api.deepseek.com/v1
DSH_PROBE_API_KEY=
DSH_PROBE_MODEL=deepseek-chat
DSH_PROBE_MAX_TOKENS=
DSH_PROBE_TIMEOUT=240
DSH_PROBE_OUT=
